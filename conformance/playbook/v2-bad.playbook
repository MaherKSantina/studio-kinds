version: 2
title: Bad v2
decisions:
  - key: d
    label: D
    values: [{key: a, label: A}, {key: b, label: B}]
  - key: e
    label: E
    values: [{key: x, label: X}]
events:
  - key: rules-here
    label: Has status and sets
    status: ready
    sets: [d=a]
    content:
      - {kind: md, doc: first}
      - {kind: md, doc: second}
  - key: file-entry
    label: File
    content: {file: beside.md, label: Beside}
  - key: neither
    label: Neither
    content: {kind: md, label: Nothing}
  - key: no-kind
    label: No kind
    content: {doc: hi}
  - key: both
    label: Both
    content: {kind: md, doc: hi, docs: {d=a: x}, by: [d]}
  - key: doc-by
    label: Doc by
    content: {kind: md, doc: hi, by: [d]}
  - key: docs-no-by
    label: Docs no by
    content: {kind: md, docs: {d=a: x}}
  - key: docs-bad-keys
    label: Docs bad keys
    content:
      kind: md
      by: [d, e]
      docs:
        d=a,e=x: one
        d=c,e=x: wrong
        e=x,d=b: wrong order
  - key: by-unknown
    label: By unknown
    content: {kind: md, by: [zz], docs: {zz=1: x}}
  - key: md-not-string
    label: Md not string
    content: {kind: md, doc: {a: 1}}
  - key: unknown-kind
    label: Unknown kind
    content: {kind: widget, doc: {}}
  - key: nested-broken
    label: Nested broken
    content:
      kind: brief
      by: [e]
      docs:
        e=x:
          title: inner
          sections:
            - title: S
              content: {kind: kanban, doc: {title: b, columns: [], tasks: [{title: no key}]}}
topics:
  - key: t
    label: T
    content: {kind: md, doc: x}
rules:
  - event: rules-here
    process: p
view:
  locks: [d=a]
