title: Broken rules
source: rows.csv
rules:
  - where: [{op: equals, value: x}]
    set: {a: 1}
  - where: [{field: a}]
    set: {a: 1}
  - where: [{field: a, op: nope}]
    set: {a: 1}
  - where: [{field: name, op: equals, value: Cabin}]
  - where: [{field: name, op: equals, value: Nobody}]
    set: {a: 1}
