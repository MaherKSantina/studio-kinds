clips:
  - name: bass
    notes:
      - {pitch: C2, start: 0}
  - name: bass
    notes: []
  - notes: []
  - name: silent
    notes: []
tracks:
  - name: T
    channel: 0
    clips: notalist
  - name: U
    clips:
      - {at: 0}
      - {clip: bass, at: -1}
      - {clip: bass, repeat: 0}
      - {clip: bass, transpose: 1.5}
      - {clip: nowhere}
      - {file: bass.clip}
