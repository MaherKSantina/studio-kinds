{
  "name": "studio-kinds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned YAML document kinds — playbook and brief — as pure engines, a paste-and-preview page, and a stateless validate endpoint.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name studio-kinds"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
