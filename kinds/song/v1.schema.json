{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MaherKSantina/studio-kinds/master/kinds/song/v1.schema.json",
  "title": "song",
  "description": "An arrangement: the clips the song is made of, written in under a name, and the tracks that place them. Bars count from 0 at the song's start.",
  "type": "object",
  "required": [
    "clips",
    "tracks"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "tempo": {
      "type": "number",
      "description": "Default: the first clip's.",
      "exclusiveMinimum": 0,
      "maximum": 999
    },
    "time": {
      "description": "`4/4`, or `[beats, unit]`.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\s*\\d+\\s*/\\s*\\d+\\s*$"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "object",
          "properties": {
            "beats": {
              "type": "number"
            },
            "unit": {
              "type": "number"
            }
          }
        }
      ]
    },
    "clips": {
      "type": "array",
      "description": "The clips this song is made of, each a clip document written in under a `name`. A placement calls one by that name, so a riff played twice is written once.",
      "items": {
        "type": "object",
        "description": "One clip of the song: a `name`, then the clip's own fields.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "What a placement calls this clip. Unique.",
            "minLength": 1
          },
          "tempo": {
            "type": "number",
            "description": "Beats per minute (default 120).",
            "exclusiveMinimum": 0,
            "maximum": 999
          },
          "time": {
            "description": "`4/4`, or `[beats, unit]`.",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\s*\\d+\\s*/\\s*\\d+\\s*$"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "object",
                "properties": {
                  "beats": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "bars": {
            "type": "number",
            "description": "The clip's length; default = the last note rounded up to a bar.",
            "exclusiveMinimum": 0
          },
          "channel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "MIDI channel (default 1)."
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127,
            "description": "The default velocity (default 100)."
          },
          "naming": {
            "enum": [
              "scientific",
              "ableton"
            ],
            "description": "scientific: C4 is 60 (the default); ableton: C3 is 60."
          },
          "grid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "description": "Steps per bar for the lanes (default 16)."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pitch": {
                  "oneOf": [
                    {
                      "description": "A note name (`C2`, `F#3`, `Bb-1`) or a MIDI number 0–127.",
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^([A-Ga-g][#♯b♭]?-?\\d+|\\d+)$"
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 127
                        }
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "description": "A note name (`C2`, `F#3`, `Bb-1`) or a MIDI number 0–127.",
                        "oneOf": [
                          {
                            "type": "string",
                            "pattern": "^([A-Ga-g][#♯b♭]?-?\\d+|\\d+)$"
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 127
                          }
                        ]
                      },
                      "description": "A chord."
                    }
                  ]
                },
                "start": {
                  "type": "number",
                  "description": "Beat the note begins on.",
                  "minimum": 0
                },
                "length": {
                  "type": "number",
                  "description": "Beats (default 1).",
                  "exclusiveMinimum": 0
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                }
              },
              "required": [
                "pitch"
              ]
            }
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pitch": {
                  "description": "A note name (`C2`, `F#3`, `Bb-1`) or a MIDI number 0–127.",
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^([A-Ga-g][#♯b♭]?-?\\d+|\\d+)$"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    }
                  ]
                },
                "steps": {
                  "type": "string",
                  "description": "One character per step: `x` a hit, `X` an accent, `o` a ghost, `1`–`9` that ninth of 127, `.`/`-` a rest; `|` and spaces ignored."
                },
                "length": {
                  "type": "number",
                  "description": "Length of a hit, in beats.",
                  "exclusiveMinimum": 0
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                }
              },
              "required": [
                "pitch",
                "steps"
              ]
            }
          }
        },
        "$comment": "The fields after `name` are the `.clip` kind's own; see kinds/clip/v1.schema.json."
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "channel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Optional; the clip's own channel otherwise."
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clip": {
                  "type": "string",
                  "description": "The `name` of one of this song's clips.",
                  "x-studio-ref": "#/properties/clips/items/properties/name"
                },
                "at": {
                  "type": "number",
                  "description": "Bar the placement begins on; default right after the previous one on this track.",
                  "minimum": 0
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Times the clip plays back to back (default 1)."
                },
                "transpose": {
                  "type": "integer",
                  "description": "Semitones added to every pitch (default 0)."
                }
              },
              "required": [
                "clip"
              ]
            }
          }
        },
        "required": [
          "clips"
        ]
      }
    }
  },
  "$defs": {}
}
