{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MaherKSantina/studio-kinds/master/kinds/playbook/v1.schema.json",
  "title": "playbook (version 1)",
  "description": "Decisions, events, topics and rules; content is a FILE beside the book, one or more per event or topic, and a `by` file varies as `<file>.variants/<decision=answer,...>.<ext>`. The walk (`view`) is saved in the file.",
  "type": "object",
  "required": [
    "title",
    "decisions",
    "events"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Absent means 1."
    },
    "title": {
      "type": "string",
      "description": "The heading."
    },
    "description": {
      "type": "string",
      "description": "One line under the title."
    },
    "view": {
      "type": "object",
      "description": "What the host writes — the walk.",
      "properties": {
        "locks": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
            "pattern": "^[^=]+=.+$"
          },
          "description": "The assignment — which answer is taken for each decision."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "description": "The event's key."
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
                  "pattern": "^[^=]+=.+$"
                }
              },
              "locks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
                  "pattern": "^[^=]+=.+$"
                }
              }
            },
            "required": [
              "event",
              "locks"
            ]
          },
          "description": "The doors walked through, in order."
        },
        "collapsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Content that is true while you stand here.",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "when": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
              "pattern": "^[^=]+=.+$"
            },
            "description": "Present only where this holds."
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entry"
            }
          }
        },
        "required": [
          "key",
          "label",
          "content"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "How one event plays out under some condition. First matching rule wins.",
        "properties": {
          "event": {
            "type": "string",
            "description": "The event this rule is about.",
            "x-studio-ref": "#/properties/events/items/properties/key"
          },
          "when": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
              "pattern": "^[^=]+=.+$"
            }
          },
          "status": {
            "enum": [
              "ready",
              "gap",
              "n/a"
            ]
          },
          "process": {
            "type": "string",
            "description": "What we do.",
            "x-studio-format": "markdown"
          },
          "sets": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
              "pattern": "^[^=]+=.+$"
            },
            "description": "Answers this event changes."
          },
          "note": {
            "type": "string"
          },
          "every": {
            "type": "number",
            "description": "How often this recurs, in months."
          },
          "from": {
            "type": "string",
            "description": "The event the clock is anchored to."
          },
          "offset": {
            "type": "number",
            "description": "Days after the anchor before the first occurrence is due."
          }
        },
        "required": [
          "event"
        ]
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "description": "A question, with its answers. A state is the set of answers taken; none is ever written.",
      "properties": {
        "key": {
          "type": "string",
          "description": "Identity — appears in every `when` and `docs` key."
        },
        "label": {
          "type": "string",
          "description": "The question as shown."
        },
        "detail": {
          "type": "string",
          "description": "One line under the question."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Identity of the answer; a ref is `decision=answer`."
              },
              "label": {
                "type": "string",
                "description": "The answer as shown."
              },
              "detail": {
                "type": "string",
                "description": "One line under the answer."
              },
              "activates": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Decisions that exist only while this answer is taken.",
                "x-studio-ref": "#/properties/decisions/items/properties/key"
              },
              "when": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A ref `decision=answer` — the decision's key, `=`, the answer's key.",
                  "pattern": "^[^=]+=.+$"
                },
                "description": "The answer is on offer only while every ref holds."
              }
            },
            "required": [
              "key",
              "label"
            ]
          },
          "description": "The answers on offer."
        }
      },
      "required": [
        "key",
        "label",
        "values"
      ]
    },
    "event": {
      "type": "object",
      "description": "One event.",
      "properties": {
        "key": {
          "type": "string",
          "description": "Identity of the event."
        },
        "label": {
          "type": "string",
          "description": "The event as shown in the rail."
        },
        "trigger": {
          "enum": [
            "imposed",
            "chosen"
          ],
          "description": "`imposed` arrives whether or not we are ready (default); `chosen` fires when we say so."
        },
        "arity": {
          "enum": [
            "once",
            "many"
          ],
          "description": "`once` (default) is a move; `many` never leaves the table."
        },
        "rate": {
          "type": "string",
          "description": "How often a `many` event fires, such as `5/w`."
        },
        "domain": {
          "type": "string",
          "description": "A grouping heading in the rail."
        },
        "detail": {
          "type": "string",
          "description": "One italic line shown when the event is open."
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "entry": {
      "type": "object",
      "description": "One file the event or topic shows.",
      "properties": {
        "file": {
          "type": "string",
          "description": "A document beside the book, relative to the root book's folder."
        },
        "label": {
          "type": "string"
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The decisions this file varies by.",
          "x-studio-ref": "#/properties/decisions/items/properties/key"
        }
      },
      "required": [
        "file"
      ]
    }
  }
}
