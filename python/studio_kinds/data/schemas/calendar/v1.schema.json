{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MaherKSantina/studio-kinds/master/kinds/calendar/v1.schema.json",
  "title": "calendar",
  "description": "Dated work on a month grid: the tasks, their dependency edges and durations, and the day everything must be done by. Every date shown is derived from those — none is written down.",
  "type": "object",
  "required": [
    "title",
    "due",
    "tasks"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "The heading."
    },
    "description": {
      "type": "string",
      "description": "One line under the title."
    },
    "due": {
      "description": "The day everything must be done by — the anchor the schedule chains backward from. `YYYY-MM-DD`, bare or quoted.",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "description": "The dated work; the schedule follows from the edges and durations, never from a date written here."
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "description": "One chip on the grid.",
      "properties": {
        "key": {
          "type": "string",
          "description": "The stable key `needs` edges point at. Unique."
        },
        "title": {
          "type": "string",
          "description": "The chip's heading."
        },
        "note": {
          "type": "string",
          "description": "One line under the title."
        },
        "body": {
          "type": "string",
          "description": "The task's own prose.",
          "x-studio-format": "markdown"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisites, each the `key` of another task in this calendar. A key no task has, the task itself, or a cycle is a problem.",
          "x-studio-ref": "#/properties/tasks/items/properties/key",
          "x-studio-acyclic": true
        },
        "duration": {
          "type": "number",
          "description": "Calendar days the task takes (default 1).",
          "exclusiveMinimum": 0
        },
        "due": {
          "description": "A per-task cap, tighter than the calendar's. `YYYY-MM-DD`, bare or quoted.",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "key",
        "title"
      ]
    }
  }
}
