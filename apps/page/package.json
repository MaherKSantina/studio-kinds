{
  "name": "studio-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The paste-and-check page: a document as YAML on the left, the Studio's own renderer on the right, checked on every keystroke in the browser — and the same check as a stateless endpoint.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name studio-kinds"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "crosscut": "workspace:*",
    "filekinds": "workspace:*",
    "js-yaml": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
